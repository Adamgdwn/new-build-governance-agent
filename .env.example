# New Build Governance Agent — environment variable template
# Copy to .env or export these before running provider-backed commands.
# Never commit live values. Use master-env-run for production secrets.

# Governance agent home (auto-detected from repo root; override if needed)
# GOVERNANCE_HOME=/path/to/new-build-governance-agent

# GitHub personal access token (used by promotion_execute.py for GitHub publish)
GITHUB_TOKEN=

# Anthropic API key (used by AI-assisted check generation if enabled)
ANTHROPIC_API_KEY=

# OpenAI keys (used by AI-assisted check generation if enabled)
OPENAI_API_KEY=
OPENAI_ADMIN_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Stripe keys (used by stripe_provision.py for Stripe workspace setup)
STRIPE_SECRET_KEY=
STRIPE_RESTRICTED_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
